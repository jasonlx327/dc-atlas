{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "idc-atlas",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "idc-index.com",
      "custom_domain": true
    },
    {
      "pattern": "admin.idc-index.com",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "IDC_DAILY_SNAPSHOTS",
      "id": "cfce6342622a4d6baceed1bd4f77a0b2"
    }
  ],
  "triggers": {
    "crons": ["30 21 * * *", "30 4 * * *", "0 22 * * *", "30 22 * * *", "30 12 * * *"]
  },
  "vars": {
    "ATLAS_ADMIN_HOST": "admin.idc-index.com",
    "ATLAS_ADMIN_EMAIL": "Jasonlix993@gmail.com",
    "ATLAS_ACCESS_TEAM_DOMAIN": "idc-atlas-admin.cloudflareaccess.com",
    "ATLAS_ACCESS_AUD": "ea4a26e2b77b58365ab4460aee2fd97e611b60b1ba7820162b7ff3bb102c9310",
    "ATLAS_SCORING_ENABLED": "false",
    "ATLAS_SCORING_PROVIDER": "openai-compatible",
    "ATLAS_SCORING_BASE_URL": "https://api.deepseek.com",
    "ATLAS_SCORING_MODEL": "deepseek-v4-flash",
    "ATLAS_SCORING_TIMEOUT_MS": "20000",
    "ATLAS_SCORING_DAILY_CALL_LIMIT": "36"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/robots.txt",
      "/sitemap.xml",
      "/feed.xml",
      "/en/feed.xml",
      "/llms.txt",
      "/en/llms.txt"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
