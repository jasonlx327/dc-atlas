{
  "name": "idc-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/prepare-sites-build.mjs",
    "cf:check": "wrangler deploy --dry-run",
    "cf:types": "wrangler types",
    "check:live": "node scripts/check-live-data.mjs",
    "check:seo": "node scripts/check-seo-geo.mjs",
    "deploy": "npm run build && wrangler deploy && npm run check:live",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "event:verify-migration": "node --experimental-strip-types scripts/verify-event-intelligence-migration.ts",
    "event:shadow": "node --experimental-strip-types scripts/run-event-intelligence-shadow.ts",
    "event:evaluate": "node --experimental-strip-types scripts/evaluate-event-strategy.ts",
    "event:render": "node --experimental-strip-types scripts/render-event-run-report.ts",
    "event:test": "node --experimental-strip-types scripts/test-event-intelligence.ts",
    "event:acceptance": "node --experimental-strip-types scripts/build-event-shadow-acceptance.ts",
    "event:replay:build": "node --experimental-strip-types scripts/build-event-replay-corpus.ts",
    "event:label-audit": "node --experimental-strip-types scripts/build-event-label-audit.ts",
    "event:replay:validate": "node --experimental-strip-types scripts/validate-event-replay-corpus.ts",
    "event:replay": "npm run event:replay:build && npm run event:label-audit && npm run event:replay:build && npm run event:replay:validate && node --experimental-strip-types scripts/run-event-intelligence-replay.ts",
    "event:source-health": "node --experimental-strip-types scripts/build-event-source-health.ts",
    "event:cluster-regression": "node --experimental-strip-types scripts/run-event-clustering-regression.ts",
    "event:timezone": "node --experimental-strip-types scripts/test-event-timezones.ts",
    "event:provider-report": "node --experimental-strip-types scripts/build-event-provider-report.ts",
    "event:provider:test": "node --experimental-strip-types scripts/test-event-provider-contract.ts",
    "event:gate-invariants": "node --experimental-strip-types scripts/test-event-gate-invariants.ts",
    "event:shadow:record": "node --experimental-strip-types scripts/record-event-shadow-slot.ts",
    "event:historical-replay": "node --experimental-strip-types scripts/run-event-historical-replay.ts",
    "event:gate4:readiness": "node --experimental-strip-types scripts/build-event-gate4-readiness.ts",
    "event:feedback:test": "node --experimental-strip-types scripts/test-editorial-feedback.ts",
    "event:model:test": "node --experimental-strip-types scripts/test-model-scoring.ts",
    "event:daily-selection:test": "node --experimental-strip-types scripts/test-daily-model-selection.ts",
    "event:auto-editor:test": "node --experimental-strip-types scripts/test-atlas-auto-editor.ts",
    "event:intelligence:apply": "node --experimental-strip-types scripts/apply-intelligence-editor-decisions.ts",
    "event:intelligence:test": "node --experimental-strip-types scripts/test-intelligence-publication.ts",
    "event:daily-closure:test": "node --experimental-strip-types scripts/test-daily-section-closure.ts",
    "event:codex:scan": "node --experimental-strip-types scripts/run-event-intelligence-shadow.ts --mode=live --slot=event-night --output=codex-event-night.json --concurrency=6 --retries=2",
    "event:codex:ingest": "node --experimental-strip-types scripts/publish-codex-event-run.ts --slot=event-night --input=artifacts/event-intelligence/codex-event-night.json",
    "event:codex:brief": "node --experimental-strip-types scripts/build-codex-editorial-brief.ts",
    "event:codex:judge:ingest": "node --experimental-strip-types scripts/publish-codex-editorial-judgment.ts",
    "event:codex:test": "node --experimental-strip-types scripts/test-codex-event-ingest.ts && node --experimental-strip-types scripts/test-codex-editorial-judgment.ts",
    "event:company-watch:test": "node --experimental-strip-types scripts/test-core-company-watchlist.ts",
    "event:candidates:show": "wrangler kv key get event-intelligence:daily-candidates:latest --binding IDC_DAILY_SNAPSHOTS --remote",
    "event:closure:show": "wrangler kv key get atlas-daily-update:closure:latest --binding IDC_DAILY_SNAPSHOTS --remote",
    "event:cloudflare:preflight": "node scripts/check-cloudflare-control-plane.mjs",
    "auth:test": "node --experimental-strip-types scripts/test-access-auth.ts",
    "event:acceptance:shadow": "node --experimental-strip-types scripts/run-event-intelligence-shadow.ts --mode=live --slot=event-night --db=/private/tmp/idc-atlas-event-intelligence-acceptance.sqlite --output=event-night-live-gate3.json && node --experimental-strip-types scripts/run-event-intelligence-shadow.ts --mode=live --slot=event-day --db=/private/tmp/idc-atlas-event-intelligence-acceptance.sqlite --output=event-day-live-gate3.json && npm run event:evaluate && npm run event:acceptance"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
